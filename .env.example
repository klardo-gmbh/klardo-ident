# KlardoIdent quick start — configuration.
#
# ./start.sh copies this file to .env on first run and fills every GENERATE_ME
# with a random value. Copy it by hand instead if you would rather choose them:
#
#   cp .env.example .env && ${EDITOR:-vi} .env
#
# .env is gitignored. It holds the only copy of these secrets.

# --- Versions ---------------------------------------------------------------
# Pinned to what was current when these files were published. Under 0.x a minor
# bump may break, so an install follows a version it chose rather than whatever
# is newest. Raise these, then `docker compose pull && docker compose up -d`.
#
# LEAVE EITHER EMPTY to follow the moving minor tag instead (0.4 /
# 0.5): the newest patch is pulled on every `docker compose pull`,
# and nothing has to be looked up. Patches never break; a minor may, which is
# why the fallback stops there. `git pull` in this repository moves the pins to
# a newer minor when one exists.
IDENT_VERSION=0.4.6
ADMINUI_VERSION=0.5.6

# --- Where it answers -------------------------------------------------------
# SERVER_URL is the PUBLIC url of the server and becomes the `iss` of every
# token. Get it right before any client exists — it is the hardest value to
# change afterwards. Behind TLS this is the https:// address, not localhost.
SERVER_URL=http://localhost:8080
IDENT_PORT=8080
ADMIN_UI_PORT=5174

# The console's origin, registered on the admin client when the realm is
# created. Change it together with ADMIN_UI_PORT / your TLS hostname.
ADMIN_UI_ORIGIN=http://localhost:5174

# The realm the console administers when its URL names none. `master` is the
# admin realm, created on first start.
DEFAULT_REALM=master

# development keeps cookies working over plain http, which is what an evaluation
# on localhost needs. Set production once TLS is in front — cookies then require
# https, and the server logs as a production install.
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Secrets ----------------------------------------------------------------
# Signs the tokens. Keep it stable: rotating it invalidates every issued token.
JWT_SECRET=GENERATE_ME

# The master realm's first administrator. Read on FIRST START only — changing
# them later here does nothing; change the password in the console.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=GENERATE_ME

# The built-in admin and account clients. Required for a confidential flow
# against either of them.
ADMIN_CLIENT_SECRET=GENERATE_ME
ACCOUNT_CLIENT_SECRET=GENERATE_ME

# --- Database ---------------------------------------------------------------
MONGO_DB_NAME=kident

# --- Licence ----------------------------------------------------------------
# Empty is the free plan: 1 realm, 2 clients, 10 users, perpetual. A licence key
# raises the limits and unlocks the licensed features; the banner prints which
# plan the install resolved.
LICENSE_KEY=
